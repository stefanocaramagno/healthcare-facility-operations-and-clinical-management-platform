# File: .env.example
#
# Scopo
# -----
# Fornire un template delle variabili di ambiente richieste dal progetto,
# documentando i parametri necessari per configurare database, autenticazione,
# comunicazione tra servizi, frontend, AI Assistant e infrastruttura email.
#
# Ruolo nel sistema
# -----
# Questo file rappresenta il modello di riferimento per la configurazione
# dell’ambiente applicativo. Può essere copiato in un file `.env` e adattato
# alle caratteristiche dell’ambiente di esecuzione senza modificare direttamente
# i file sorgente dei singoli servizi.
#
# Note
# -----
# - I valori presenti sono predisposti per un ambiente di sviluppo locale o demo.
# - Il file documenta tutte le principali variabili richieste dai servizi.
# - In ambienti reali i secret, le password e le chiavi devono essere sostituiti
#   con valori sicuri e gestiti mediante meccanismi dedicati.
# - Il file `.env.example` può essere versionato perché funge da template,
#   mentre eventuali configurazioni reali sensibili dovrebbero essere protette.

# Credenziali e porta del database MySQL principale.
MYSQL_ROOT_PASSWORD=devroot
MYSQL_PORT=3306

# Parametri di connessione base al servizio MySQL dalla rete Docker.
DB_HOST=mysql
DB_PORT=3306

# Nome del database principale di riferimento.
DB_NAME=healthcare_registry

# Credenziali applicative usate dai servizi per accedere al database.
DB_USER=app_user
DB_PASSWORD=app_password

# Nomi logici dei database associati ai diversi domini applicativi.
DB_REGISTRY_NAME=healthcare_registry
DB_SCHEDULING_NAME=healthcare_scheduling
DB_CLINICAL_NAME=healthcare_clinical
DB_PAYMENTS_NAME=healthcare_payments
DB_EVENTS_NAME=healthcare_events

# Configurazione dell’autenticazione JWT emessa dal Core Service.
JWT_ISSUER=Healthcare.CoreService
JWT_SECRET=DEV_HEALTHCARE_SUPER_LONG_SIGNING_KEY_0123456789
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
AUTH_ENABLED=true

# Secret condiviso per comunicazioni interne trusted tra servizi.
INTERNAL_SERVICE_SECRET=DEV_INTERNAL_SERVICE_SECRET_0123456789

# Parametri di esposizione del gateway e URL base dei servizi interni.
GATEWAY_PORT=8000
CORE_BASE_URL=http://core-service:8080
AI_BASE_URL=http://ai-assistant:8000

# Configurazione del servizio Django AI Assistant.
DJANGO_SECRET_KEY=dev-secret-change-me
DJANGO_DEBUG=false
DJANGO_LOG_LEVEL=INFO

# Parametri usati per la costruzione dei link frontend legati al reset password.
FRONTEND_BASE_URL=http://localhost:8080
PASSWORD_RESET_PAGE_PATH=/pages/auth/reset-password.html
PASSWORD_RESET_TOKEN_LIFETIME_MINUTES=60

# Parametri usati per i link pubblici di attivazione account.
PUBLIC_BASE_URL=http://localhost:8080
ACCOUNT_ACTIVATION_CONFIRM_PATH=/api/auth/activate/confirm
ACCOUNT_ACTIVATION_TOKEN_LIFETIME_MINUTES=1440

# Configurazione SMTP per l’invio email tramite Mailpit in ambiente locale.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_FROM_EMAIL=no-reply@healthcare.local
SMTP_FROM_NAME=Healthcare Portal
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_SSL=false
